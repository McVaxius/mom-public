<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>mom</AssemblyName>
    <RootNamespace>mom.PublicShell</RootNamespace>
    <Version>5.0.0.2</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateRepositoryUrlAttribute>false</GenerateRepositoryUrlAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <IsPackable>false</IsPackable>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="IntroductionWindow.cs;IModule.cs;ModuleLoader.cs;ModulePackage.cs;BuildInfo.cs;TrustAnchor.cs;PrivateManifest.cs" />
    <Compile Include="UiStyle.cs;ManagedUiFonts.cs;PublicPreferences.cs;PublicUi.cs" />
    <ProjectReference Include="../aethertekUI/src/AethertekUI/AethertekUI.csproj" />
    <ProjectReference Include="../aethertekUI/src/AethertekUI.Dalamud/AethertekUI.Dalamud.csproj" />
    <EmbeddedResource Include="Localization/Strings.*.resx" LogicalName="mom.PublicShell.%(Filename).resources" WithCulture="false" />
    <None Include="mom.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PackagePublicHost" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <!-- Package explicit public files; the CLR ABI version stays 1.0.0.0. -->
    <PropertyGroup><_PublicPackageDir>$(IntermediateOutputPath)public-package/</_PublicPackageDir></PropertyGroup>
    <RemoveDir Directories="$(_PublicPackageDir)" />
    <MakeDir Directories="$(_PublicPackageDir);$(_PublicPackageDir)Notices;$(TargetDir)$(AssemblyName)" />
    <ItemGroup>
      <_PublicPackageFiles Include="$(TargetPath);$(TargetDir)$(AssemblyName).deps.json;$(TargetDir)AethertekUI.dll;$(TargetDir)AethertekUI.Dalamud.dll;$(TargetDir)Glasswork.dll;$(TargetDir)Glasswork.Glass.dll;$(TargetDir)Glasswork.Backend.dll;$(ProjectDir)$(AssemblyName).json;$(ProjectDir)icon.png;$(ProjectDir)README.md;$(ProjectDir)LICENSE;$(ProjectDir)THIRD-PARTY-NOTICES.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublicPackageFiles)" DestinationFolder="$(_PublicPackageDir)" />
    <Copy SourceFiles="$(TargetDir)Notices/Glasswork.MIT.txt" DestinationFolder="$(_PublicPackageDir)Notices" />
    <Copy SourceFiles="$(ProjectDir)$(AssemblyName).json" DestinationFolder="$(TargetDir)$(AssemblyName)" />
    <ZipDirectory SourceDirectory="$(_PublicPackageDir)" DestinationFile="$(TargetDir)$(AssemblyName)/latest.zip" Overwrite="true" />
  </Target>
</Project>
